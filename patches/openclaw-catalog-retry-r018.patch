diff --git a/src/agents/prepared-model-runtime.publication-events.test.ts b/src/agents/prepared-model-runtime.publication-events.test.ts
index e1ace85..7cd84aa 100644
--- a/src/agents/prepared-model-runtime.publication-events.test.ts
+++ b/src/agents/prepared-model-runtime.publication-events.test.ts
@@ -109,4 +109,57 @@ describe("catalog attempt status publication", () => {
       unregister();
     }
   });
+
+  it("records each failed background provider acquisition without exposing pending status", () => {
+    const onFailure = vi.fn();
+    const reporter = createCatalogAttemptReporter(
+      {},
+      { key: "synthetic", pluginFingerprint: "synthetic", credentials: {} },
+      () => true,
+      onFailure,
+    );
+    const catalog = reporter.withRefreshStatus({ entries: [], routeVariants: [] });
+    const events = vi.fn();
+    const unregister = registerPreparedModelRuntimePublicationListener(events);
+    try {
+      reporter.setPending(["fixture"], "provider");
+      expect(catalog.pendingProviders).toEqual(["fixture"]);
+      reporter.failed(new Error("initial request"), ["fixture"], "provider");
+      expect(onFailure).toHaveBeenCalledTimes(1);
+      const priorStatusCount = events.mock.calls.filter(
+        ([event]) => event.phase === "catalog-status",
+      ).length;
+      reporter.setPending(["fixture"], "provider", true);
+      expect(catalog.pendingProviders).toBeUndefined();
+      reporter.failed(new Error("background renewal"), ["fixture"], "provider");
+      expect(onFailure).toHaveBeenCalledTimes(2);
+      reporter.failed(new Error("duplicate late report"), ["fixture"], "provider");
+      expect(onFailure).toHaveBeenCalledTimes(2);
+      expect(
+        events.mock.calls.filter(([event]) => event.phase === "catalog-status"),
+      ).toHaveLength(priorStatusCount);
+    } finally {
+      unregister();
+    }
+  });
+
+  it("retains the silent failed-provider scope after sibling publication", () => {
+    const onFailure = vi.fn();
+    const reporter = createCatalogAttemptReporter(
+      {},
+      { key: "synthetic", pluginFingerprint: "synthetic", credentials: {} },
+      () => true,
+      onFailure,
+    );
+    const catalog = reporter.withRefreshStatus({ entries: [], routeVariants: [] });
+    reporter.setPending(["success", "failure"], "provider", true);
+    expect(catalog.pendingProviders).toBeUndefined();
+    reporter.published(["success"], "provider");
+    reporter.failed(new Error("failure after partial publication"), ["failure"], "provider");
+    expect(onFailure).toHaveBeenCalledTimes(1);
+    expect(catalog.refreshFailures).toEqual([
+      { acquisition: "provider", provider: "failure" },
+    ]);
+    expect(catalog.pendingProviders).toBeUndefined();
+  });
 });
